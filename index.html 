<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PLOD Lite</title>

<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#eef3f0;
  color:#18352b;
}
header{
  background:#075b3b;
  color:white;
  padding:18px;
  text-align:center;
}
header h1{margin:0;font-size:25px}
header p{margin:5px 0 0;font-size:13px}

.container{
  max-width:1100px;
  margin:auto;
  padding:15px;
}
.card{
  background:white;
  border-radius:14px;
  padding:18px;
  margin-bottom:18px;
  box-shadow:0 3px 12px rgba(0,0,0,.10);
}
h2{margin-top:0;color:#075b3b}

label{
  display:block;
  font-weight:bold;
  margin:12px 0 5px;
}
input,textarea,select{
  width:100%;
  padding:12px;
  border:1px solid #bbb;
  border-radius:8px;
  font-size:16px;
}
textarea{min-height:80px;resize:vertical}

button{
  width:100%;
  padding:13px;
  margin-top:10px;
  border:0;
  border-radius:8px;
  background:#075b3b;
  color:white;
  font-size:16px;
  font-weight:bold;
}
button.secondary{background:#45665a}
button.green{background:#087f52}
button.danger{background:#a52b2b}

.a4{
  width:210mm;
  min-height:297mm;
  max-width:100%;
  margin:20px auto;
  background:white;
  padding:25mm;
  box-shadow:0 2px 15px rgba(0,0,0,.18);
  color:#111;
}
.a4-header{
  text-align:center;
  border-bottom:2px solid #075b3b;
  padding-bottom:15px;
}
.a4-header h1{margin:0;color:#075b3b}
.a4-header p{margin:5px}

.document-title{
  text-align:center;
  margin:30px 0;
  font-size:22px;
  font-weight:bold;
  text-decoration:underline;
}

.document-body{
  font-size:16px;
  line-height:1.8;
}
.signature{
  margin-top:60px;
}
.stamp{
  border:2px solid #075b3b;
  width:150px;
  height:80px;
  display:flex;
  align-items:center;
  justify-content:center;
  margin-top:20px;
  font-weight:bold;
  color:#075b3b;
}

.actions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}

@media(max-width:700px){
  .actions{grid-template-columns:1fr}
  .a4{
    width:100%;
    padding:20px;
    box-shadow:none;
  }
}

@media print{
  body{background:white}
  header,.controls,.card:not(.document-card){display:none!important}
  .document-card{
    display:block!important;
    margin:0;
    padding:0;
    box-shadow:none;
  }
  .a4{
    width:210mm;
    min-height:297mm;
    margin:0;
    padding:20mm;
    box-shadow:none;
  }
}
</style>
</head>

<body>

<header>
  <h1>PLOD LITE</h1>
  <p>Property and Land Occupants Database</p>
</header>

<div class="container">

<div class="card controls">
  <h2>Create Document</h2>

  <label>First Name</label>
  <input id="firstName" placeholder="Enter first name">

  <label>Surname</label>
  <input id="surname" placeholder="Enter surname">

  <label>ID Number</label>
  <input id="idNumber" placeholder="Enter ID number">

  <label>Stand / Property Number</label>
  <input id="standNumber" placeholder="Enter stand number">

  <label>Address</label>
  <textarea id="address" placeholder="Enter property address"></textarea>

  <label>Document Type</label>
  <select id="documentType">
    <option value="confirmation">Confirmation of Permanent Occupancy</option>
    <option value="residency">Proof of Residency</option>
    <option value="ownership">Property Occupancy Confirmation</option>
    <option value="letter">Official PLOD Letter</option>
    <option value="certificate">PLOD Certificate</option>
  </select>

  <div class="actions">
    <button onclick="generateDocument()">Generate Document</button>
    <button class="secondary" onclick="clearForm()">Clear</button>
    <button class="green" onclick="downloadDocument()">Download to Phone</button>
    <button class="secondary" onclick="window.print()">Print / Save PDF</button>
  </div>
</div>

<div class="card document-card">
  <div class="a4" id="document">

    <div class="a4-header">
      <h1>PLOD LITE</h1>
      <p>Property and Land Occupants Database</p>
      <p>Official Document</p>
    </div>

    <div class="document-title" id="docTitle">
      CONFIRMATION OF PERMANENT OCCUPANCY
    </div>

    <div class="document-body">

      <p>
        This document confirms that the following information has been
        recorded in the PLOD Lite Property and Land Occupants Database.
      </p>

      <p>
        <strong>Name:</strong>
        <span id="outName">________________________</span>
      </p>

      <p>
        <strong>Surname:</strong>
        <span id="outSurname">________________________</span>
      </p>

      <p>
        <strong>ID Number:</strong>
        <span id="outID">________________________</span>
      </p>

      <p>
        <strong>Stand / Property Number:</strong>
        <span id="outStand">________________________</span>
      </p>

      <p>
        <strong>Address:</strong><br>
        <span id="outAddress">________________________</span>
      </p>

      <p>
        This document is generated from information entered into the
        PLOD Lite database and is intended for official administrative
        record purposes.
      </p>

      <p>
        <strong>Reference Number:</strong>
        <span id="reference">PLOD-000000</span>
      </p>

      <div class="signature">
        <p>____________________________</p>
        <p><strong>Authorised PLOD Official</strong></p>

        <div class="stamp">
          OFFICIAL STAMP
        </div>
      </div>

    </div>
  </div>
</div>

</div>

<script>
function generateDocument(){

  const firstName =
    document.getElementById("firstName").value.trim();

  const surname =
    document.getElementById("surname").value.trim();

  const id =
    document.getElementById("idNumber").value.trim();

  const stand =
    document.getElementById("standNumber").value.trim();

  const address =
    document.getElementById("address").value.trim();

  const type =
    document.getElementById("documentType").value;

  document.getElementById("outName").textContent =
    firstName || "________________________";

  document.getElementById("outSurname").textContent =
    surname || "________________________";

  document.getElementById("outID").textContent =
    id || "________________________";

  document.getElementById("outStand").textContent =
    stand || "________________________";

  document.getElementById("outAddress").textContent =
    address || "________________________";

  const titles={
    confirmation:"CONFIRMATION OF PERMANENT OCCUPANCY",
    residency:"PROOF OF RESIDENCY",
    ownership:"PROPERTY OCCUPANCY CONFIRMATION",
    letter:"OFFICIAL PLOD LETTER",
    certificate:"PLOD CERTIFICATE"
  };

  document.getElementById("docTitle").textContent =
    titles[type];

  const random =
    Math.floor(100000 + Math.random()*900000);

  document.getElementById("reference").textContent =
    "PLOD-" + new Date().getFullYear() + "-" + random;
}

function clearForm(){
  document.getElementById("firstName").value="";
  document.getElementById("surname").value="";
  document.getElementById("idNumber").value="";
  document.getElementById("standNumber").value="";
  document.getElementById("address").value="";
}

function downloadDocument(){

  generateDocument();

  const content =
    document.getElementById("document").outerHTML;

  const html=`
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>PLOD Document</title>
<style>
body{font-family:Arial;margin:0}
.a4{
width:210mm;
min-height:297mm;
padding:25mm;
box-sizing:border-box;
}
.a4-header{
text-align:center;
border-bottom:2px solid #075b3b;
padding-bottom:15px;
}
.a4-header h1{color:#075b3b}
.document-title{
text-align:center;
margin:30px 0;
font-size:22px;
font-weight:bold;
text-decoration:underline;
}
.document-body{
font-size:16px;
line-height:1.8;
}
.stamp{
border:2px solid #075b3b;
width:150px;
height:80px;
display:flex;
align-items:center;
justify-content:center;
margin-top:20px;
font-weight:bold;
color:#075b3b;
}
</style>
</head>
<body>
${content}
</body>
</html>`;

  const blob =
    new Blob([html],{type:"text/html"});

  const url =
    URL.createObjectURL(blob);

  const a=document.createElement("a");
  a.href=url;
  a.download="PLOD-Document.html";
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);

  URL.revokeObjectURL(url);
}
</script>

</body>
</html>